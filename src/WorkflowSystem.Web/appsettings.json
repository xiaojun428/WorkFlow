{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    // 生产环境请通过环境变量 / User Secrets / Key Vault 提供，不要提交真实连接字符串。
    "WorkflowDb": "Server=localhost\\MSSQLSERVER1;Database=WorkflowSystem;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "AzureAd": {
    // Microsoft Entra ID（Azure AD）应用注册信息。留空则启用开发环境回退身份（Cookie + 测试用户）。
    // Instance 默认 https://login.microsoftonline.com/；TenantId 支持 "organizations"/"common"/具体租户。
    "Instance": "https://login.microsoftonline.com/",
    "Domain": "",
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": "",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc"
  },
  "ApprovalReminder": {
    // 审批催办配置（需求 7）：超时时长与催办间隔。
    "Timeout": "48:00:00",
    "ReminderInterval": "24:00:00"
  },
  "AllowedHosts": "*"
}
