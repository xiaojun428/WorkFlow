@model PagedResult<ApprovalTaskListItemDto>
@{
    ViewData["Title"] = "我已审批";
}

<div class="container mt-4">
    <h2>我已审批</h2>

    @if (Model.Items.Count == 0)
    {
        <div class="alert alert-info">暂无已审批的记录。</div>
    }
    else
    {
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>文档编号</th>
                    <th>标题</th>
                    <th>类型</th>
                    <th>节点</th>
                    <th>状态</th>
                    <th>完成时间</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.DocumentNo</td>
                        <td>@item.DocumentTitle</td>
                        <td>@item.DocumentTypeName</td>
                        <td>@item.StepName</td>
                        <td>@item.Status</td>
                        <td>@(item.CompletedAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
