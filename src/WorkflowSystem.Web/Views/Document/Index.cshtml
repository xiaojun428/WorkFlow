@model PagedResult<DocumentListItemDto>
@{
    ViewData["Title"] = "文档中心";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>文档中心</h2>
    <a asp-action="Create" class="btn btn-primary">新建文档</a>
</div>

@if (!Model.Items.Any())
{
    <div class="alert alert-info">暂无文档。点击右上角「新建文档」开始创建。</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>编号</th>
                    <th>标题</th>
                    <th>类型</th>
                    <th>申请人</th>
                    <th>所属部门</th>
                    <th>状态</th>
                    <th>版本</th>
                    <th>创建时间</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.DocumentNo</td>
                        <td>@item.Title</td>
                        <td>@item.DocumentTypeName</td>
                        <td>@item.ApplicantName</td>
                        <td>@item.OwnerDepartmentName</td>
                        <td>
                            <span class="badge @(item.DocumentStatus == DocumentStatus.Draft ? "bg-secondary" :
                                item.DocumentStatus == DocumentStatus.InApproval ? "bg-primary" :
                                item.DocumentStatus == DocumentStatus.Approved ? "bg-success" :
                                item.DocumentStatus == DocumentStatus.Rejected ? "bg-danger" :
                                item.DocumentStatus == DocumentStatus.Returned ? "bg-warning text-dark" : "bg-secondary")">
                                @item.DocumentStatus
                            </span>
                        </td>
                        <td>v@(item.CurrentVersion)</td>
                        <td>@item.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">详情</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav>
        <ul class="pagination">
            @for (var i = 1; i <= Math.Ceiling((double)Model.TotalCount / Model.PageSize); i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-pageSize="@Model.PageSize">@i</a>
                </li>
            }
        </ul>
    </nav>
    <div class="text-muted">共 @Model.TotalCount 条记录</div>
}
