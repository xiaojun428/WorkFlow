@model IReadOnlyList<WorkflowSystem.Application.Delegations.Dtos.DelegationListItemDto>
@{
    ViewData["Title"] = "代理委托";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>代理委托</h2>
    <a asp-action="Create" class="btn btn-primary">新建委托</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">暂无委托规则。您可以在出差或休假期间将审批委托给他人。</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>委托人</th>
                <th>被委托人</th>
                <th>文档类型</th>
                <th>开始时间</th>
                <th>结束时间</th>
                <th>状态</th>
                <th>操作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.DelegatorName</td>
                    <td>@item.DelegateName</td>
                    <td>@(item.DocumentTypeName ?? "全部类型")</td>
                    <td>@item.ValidFromUtc.ToString("yyyy-MM-dd")</td>
                    <td>@item.ValidToUtc.ToString("yyyy-MM-dd")</td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge bg-success">生效中</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">已停用</span>
                        }
                    </td>
                    <td>
                        @if (item.IsActive)
                        {
                            <form asp-action="Deactivate" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">停用</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
